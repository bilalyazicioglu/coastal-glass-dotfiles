font-family = Monaspace Neon
font-size = 15

background = #101114
foreground = #E7E9EE
background-opacity = 0.70

window-padding-x = 14
window-padding-y = 12
window-padding-balance = true
window-decoration = none

cursor-style = block
cursor-style-blink = true

shell-integration = detect
shell-integration-features = title

mouse-hide-while-typing = true
scrollback-limit = 100000
confirm-close-surface = false

# Linux uses Ctrl in place of macOS Command. Shift keeps shell editing keys intact.
keybind = ctrl+shift+d=new_split:right
keybind = ctrl+shift+e=new_split:down

keybind = ctrl+alt+left=goto_split:left
keybind = ctrl+alt+right=goto_split:right
keybind = ctrl+alt+up=goto_split:up
keybind = ctrl+alt+down=goto_split:down

keybind = ctrl+shift+t=new_tab
keybind = ctrl+shift+w=close_surface
keybind = ctrl+shift+left=previous_tab
keybind = ctrl+shift+right=next_tab

keybind = alt+backspace=text:\x1b\x7f

keybind = ctrl+plus=increase_font_size:1
keybind = ctrl+minus=decrease_font_size:1
# Match the physical hyphen key regardless of the active keyboard layout.
keybind = ctrl+Minus=decrease_font_size:1
# Turkish Q maps the US/macOS hyphen position to `*`.
keybind = ctrl+*=decrease_font_size:1
keybind = ctrl+0=reset_font_size

keybind = ctrl+shift+comma=reload_config

# Wallpaper theme colors; Main retains the original configuration above.
config-file = ?coastal-theme.conf
